DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/auto_service
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Первый администратор создаётся при инициализации БД, если админов ещё нет
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin12345
FIRST_ADMIN_NAME=Администратор

# true — заполнить БД демо-данными (услуги, позиции прайса, два сотрудника) для показа
SEED_DEMO_DATA=false
